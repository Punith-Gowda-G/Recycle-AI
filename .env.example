# Copy these values into your local environment; never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
# Optional: defaults to instance/recyclelink.db
# DATABASE_PATH=instance/recyclelink.db
# Optional admin bootstrap: this email account receives admin role at startup.
# ADMIN_EMAIL=admin@example.com
# Optional AI waste image classifier (requires a compatible waste-trained model).
# HF_API_TOKEN=your_hugging_face_access_token
# HF_IMAGE_MODEL=your-username/waste-classification-model
